# These are examples. PowerShell uses $env:NAME='value'; bash uses export NAME=value.
# An .env file is NOT automatically loaded.
PTE_ASR_MODEL=small.en
PTE_DEVICE=cpu
PTE_COMPUTE_TYPE=int8
PTE_ALIGNMENT=asr
PTE_PRONUNCIATION=none
# Local phone evidence (download model files first; run-local.py already selects local):
# PTE_PRONUNCIATION=local
# PTE_PHONEME_MODEL=models/phoneme-en
PTE_ALLOW_CLOUD=false
# Azure: explicitly enable cloud transmission and configure these locally.
# PTE_PRONUNCIATION=azure
# PTE_ALLOW_CLOUD=true
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
# Optional text-only LLM coach; base URL should end at the API prefix, e.g. /v1.
# PTE_LLM_BASE_URL=
# PTE_LLM_API_KEY=
# PTE_LLM_MODEL=
